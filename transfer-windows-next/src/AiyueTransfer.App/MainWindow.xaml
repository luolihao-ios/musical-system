<Window x:Class="AiyueTransfer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="爱乐互传" Width="1060" Height="700" MinWidth="900" MinHeight="560" Background="{StaticResource PageBrush}">
  <Window.Resources>
    <Storyboard x:Key="RefreshSpin"><DoubleAnimation Storyboard.TargetName="RefreshGlyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.55"/></Storyboard>
  </Window.Resources>
  <Grid Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel>
      <TextBlock Text="爱乐互传" FontSize="27" FontWeight="Bold" Foreground="#302A55" Margin="4,8,0,48"/>
      <Button Content="接收" Click="Receive_Click" Height="48" Margin="0,0,0,8" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="17"/>
      <Button Content="发送" Click="Send_Click" Height="48" Margin="0,0,0,8" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="17"/>
      <Button Content="设置" Click="Settings_Click" Height="48" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="17"/>
    </StackPanel>
    <Grid Grid.Column="1" Margin="34,0,0,0">
      <StackPanel x:Name="ReceivePanel" Visibility="Collapsed"><TextBlock Text="接收" FontSize="28" FontWeight="Bold" Foreground="#302A55"/><Border Margin="0,28,0,0" Padding="24" Background="{StaticResource CardBrush}" CornerRadius="18"><StackPanel><TextBlock Text="正在接收附近设备的传输请求" FontSize="20" FontWeight="SemiBold" Foreground="#302A55"/><TextBlock Text="有人向此设备发送文件时，爱乐互传会显示确认框；只有您点击接收后才会保存文件。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Text="接收位置" Foreground="#302A55" FontWeight="SemiBold" Margin="0,22,0,4"/><TextBlock Text="{Binding SavePath}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
      <StackPanel x:Name="SendPanel"><TextBlock Text="选择" FontSize="18" Foreground="#302A55"/><WrapPanel Margin="0,12,0,22"><Button Content="文件" Command="{Binding ChooseFilesCommand}" Padding="28,16" Margin="0,0,12,0" Background="#EEEAFE" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/><Button Content="文件夹" Command="{Binding ChooseFolderCommand}" Padding="28,16" Margin="0,0,12,0" Background="#EEEAFE" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/><Button Content="剪贴板文本" Command="{Binding ClipboardCommand}" Padding="28,16" Background="#EEEAFE" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/></WrapPanel><TextBlock Text="{Binding SelectedSummary}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,26"/>
        <DockPanel><TextBlock Text="附近的设备" FontSize="24" FontWeight="Bold" Foreground="#302A55"/><Button DockPanel.Dock="Right" Click="Refresh_Click" ToolTip="重新搜索附近设备" Width="40" Height="40" Background="Transparent" BorderThickness="0"><TextBlock x:Name="RefreshGlyph" Text="↻" FontSize="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform></TextBlock></Button></DockPanel>
        <TextBlock Text="点击刷新会重新搜索同一 Wi-Fi 下的设备" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/>
        <Border Background="{StaticResource CardBrush}" CornerRadius="18" MinHeight="132" Padding="14"><Grid>
          <StackPanel Visibility="{Binding EmptyDevicesVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="🌐" FontSize="42" HorizontalAlignment="Center"/><TextBlock Text="正在搜索附近设备…" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
          <ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F5F2FF" CornerRadius="13" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="20" Background="#E8E4FF"><TextBlock Text="▣" FontSize="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="13,0"><TextBlock Text="{Binding Alias}" FontSize="17" FontWeight="SemiBold" Foreground="#302A55"/><TextBlock Text="{Binding DeviceType}" Foreground="{StaticResource MutedBrush}"/></StackPanel><Button Grid.Column="2" Content="发送" Command="{Binding SendCommand}" Padding="16,7" Background="#EEEAFE" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Grid></Border>
      </StackPanel>
      <StackPanel x:Name="SettingsPanel" Visibility="Collapsed"><TextBlock Text="设置" FontSize="28" FontWeight="Bold" Foreground="#302A55"/><Border Margin="0,28,0,0" Padding="24" Background="{StaticResource CardBrush}" CornerRadius="18"><StackPanel><TextBlock Text="文件保存位置" FontSize="18" FontWeight="SemiBold" Foreground="#302A55"/><TextBlock Text="{Binding SavePath}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,14"/><Button Content="选择保存位置" Command="{Binding ChooseSavePathCommand}" Width="140" HorizontalAlignment="Left" Padding="12,7" Background="#EEEAFE" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/><TextBlock Text="诊断日志" FontSize="18" FontWeight="SemiBold" Foreground="#302A55" Margin="0,28,0,0"/><TextBlock Text="日志文件：%LOCALAPPDATA%\luolihao\AiYueTransfer\diagnostics.log" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><TextBlock Text="版本 1.0.0 · 局域网自动发现已开启" Foreground="{StaticResource MutedBrush}" Margin="0,28,0,0"/></StackPanel></Border></StackPanel>
    </Grid>
  </Grid>
</Window>
