<Window x:Class="AiyueTransfer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="爱乐互传" Width="1060" Height="700" MinWidth="900" MinHeight="560" Background="{StaticResource PageBrush}">
  <Grid Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="爱乐互传" FontSize="27" FontWeight="Bold" Foreground="#302A55" Margin="4,8,0,48"/><Button Content="接收" Height="44" Margin="0,0,0,10" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="16"/><Button Content="发送" Height="44" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="16"/><Button Content="设置" Height="44" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="16"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="34,0,0,0"><DockPanel><TextBlock Text="附近设备" FontSize="28" FontWeight="Bold" Foreground="#302A55"/><Button DockPanel.Dock="Right" Content="↻  刷新" Command="{Binding RefreshCommand}" Padding="18,8" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,14,0,6"><Button Content="选择文件" Command="{Binding ChooseFilesCommand}" Padding="18,8" Background="#EEEAFE" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/><TextBlock Text="{Binding SelectedSummary}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0"/></StackPanel><TextBlock Text="选择设备后发送文件" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24"/><ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="23" Background="#E8E4FF"><TextBlock Text="▣" FontSize="25" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="16,0"><TextBlock Text="{Binding Alias}" FontSize="18" FontWeight="SemiBold" Foreground="#302A55"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DeviceType}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="  ·  在线" Foreground="#328A6B" Margin="8,0,0,0"/></StackPanel></StackPanel><Button Grid.Column="2" Content="发送" Command="{Binding SendCommand}" Padding="16,7" Background="#EEEAFE" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,36"/></StackPanel>
  </Grid>
</Window>
