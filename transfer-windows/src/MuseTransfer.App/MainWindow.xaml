<Window x:Class="MuseTransfer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="暮色互传" Width="1120" Height="720" MinWidth="900" MinHeight="600" Background="{StaticResource BackgroundBrush}" Foreground="White" AllowDrop="True" Drop="OnDrop">
  <Grid Margin="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
      <TextBlock Text="暮色互传" FontSize="27" FontWeight="SemiBold" Margin="8,8,8,30"/>
      <Button Content="传输" HorizontalContentAlignment="Left" AutomationProperties.Name="传输页面"/>
      <Button Content="历史" HorizontalContentAlignment="Left" Background="#2A252D"/><Button Content="设置" HorizontalContentAlignment="Left" Background="#2A252D"/>
    </StackPanel>
    <Grid Grid.Column="1" Margin="20,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="附近设备" FontSize="24" FontWeight="SemiBold"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14"><TextBox x:Name="AddressBox" Width="260" Padding="10" Text="https://192.168.1.2:53317"/><Button Content="手动连接" Click="OnAddAddress"/></StackPanel>
      <ListBox Grid.Row="2" ItemsSource="{Binding NearbyDevices}" SelectedItem="{Binding SelectedDevice}" Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource PanelBrush}" Padding="16" Margin="0,5" CornerRadius="10"><StackPanel><TextBlock Text="{Binding Name}" FontSize="17"/><TextBlock Text="{Binding BaseAddress}" Foreground="#A9A3AD"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="3"><TextBlock Text="将文件或文件夹拖到窗口，也可以手动选择" Foreground="#A9A3AD" Margin="4"/><StackPanel Orientation="Horizontal"><Button Content="选择文件" Click="OnChooseFiles"/><Button Content="选择文件夹" Click="OnChooseFolder"/><Button Content="发送" Click="OnSend" IsEnabled="{Binding CanSend}"/></StackPanel></StackPanel>
    </Grid>
    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20"><StackPanel><TextBlock Text="传输任务" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusText}" Margin="0,18,0,8" TextWrapping="Wrap"/><TextBlock Text="{Binding CurrentFileName}" Foreground="#A9A3AD" TextTrimming="CharacterEllipsis"/><ProgressBar Value="{Binding Progress}" Maximum="1" Height="8" Margin="0,18" Foreground="{StaticResource AccentBrush}"/><Button Content="取消" Click="OnCancel" Background="#3B343E"/></StackPanel></Border>
    <Border Grid.ColumnSpan="3" Background="#E6111014" Visibility="{Binding PendingReceiveRequest, Converter={StaticResource NullToVisibilityConverter}}" Panel.ZIndex="10">
      <Border Width="440" Padding="28" Background="#29242C" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="接收文件？" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding PendingReceiveRequest.SenderName, StringFormat=来自 {0}}" Margin="0,16,0,4"/><TextBlock Text="{Binding PendingReceiveRequest.FileCount, StringFormat={}{0} 个文件}"/><TextBlock Text="{Binding PendingReceiveRequest.VerificationCode, StringFormat=验证码 {0}}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,18"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="拒绝" Click="OnReject" Background="#3B343E"/><Button Content="接受" Click="OnAccept"/></StackPanel></StackPanel></Border>
    </Border>
  </Grid>
</Window>
