<UserControl x:Class="LocalMusicPlayer.Views.PlaylistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="#F7F3F4">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#17151A"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Margin="0,0,8,0"
                             Padding="10,8"
                             Background="#242129"
                             Foreground="#F7F3F4"
                             BorderThickness="0"
                             Text="{Binding NewPlaylistName,
                                            UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Background="#E94B5F"
                            Content="新建"
                            Command="{Binding CreateCommand}" />
                </Grid>
                <ListBox Grid.Row="1"
                         Margin="0,14,0,0"
                         ItemsSource="{Binding Playlists}"
                         SelectedItem="{Binding SelectedPlaylist}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#F7F3F4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Padding="8,4"
                                        Content="删除"
                                        Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Border Grid.Column="2"
                Background="#17151A"
                CornerRadius="12"
                Padding="28">
            <StackPanel>
                <TextBlock Text="歌单详情"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,24"
                           Text="整理属于你的本地音乐收藏"
                           Foreground="#97909B" />
                <TextBlock Text="歌单名称"
                           Foreground="#AAA3AD" />
                <TextBox Margin="0,8,0,12"
                         MaxWidth="420"
                         HorizontalAlignment="Left"
                         Padding="12,9"
                         Background="#242129"
                         Foreground="#F7F3F4"
                         BorderThickness="0"
                         Text="{Binding RenameText,
                                        UpdateSourceTrigger=PropertyChanged}" />
                <Button Width="110"
                        HorizontalAlignment="Left"
                        Background="#E94B5F"
                        Content="保存名称"
                        Command="{Binding RenameCommand}" />
                <TextBlock Margin="0,34,0,0"
                           Text="在本地音乐列表中选择歌曲，即可播放；歌单曲目管理将在播放器详情页中呈现。"
                           Foreground="#77717B"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
