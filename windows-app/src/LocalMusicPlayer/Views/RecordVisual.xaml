<UserControl x:Class="LocalMusicPlayer.Views.RecordVisual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360"
             Height="360"
             Background="Transparent">
    <UserControl.Resources>
        <Storyboard x:Key="SpinStoryboard"
                    RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RecordRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0"
                             To="360"
                             Duration="0:0:18" />
        </Storyboard>
        <Storyboard x:Key="PulseStoryboard"
                    AutoReverse="True"
                    RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Glow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.22"
                             To="0.62"
                             Duration="0:0:2.8" />
        </Storyboard>
    </UserControl.Resources>
    <Grid>
        <Ellipse x:Name="Glow"
                 Margin="22"
                 Fill="#4DE94B5F">
            <Ellipse.Effect>
                <BlurEffect Radius="34" />
            </Ellipse.Effect>
        </Ellipse>
        <Grid Margin="36"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform x:Name="RecordRotation" />
            </Grid.RenderTransform>
            <Ellipse Fill="#09090B"
                     Stroke="#38323B"
                     StrokeThickness="2" />
            <Ellipse Margin="22"
                     Stroke="#28242B"
                     StrokeThickness="1" />
            <Ellipse Margin="42"
                     Stroke="#302A33"
                     StrokeThickness="1" />
            <Ellipse Margin="62"
                     Stroke="#28242B"
                     StrokeThickness="1" />
            <Ellipse Margin="88"
                     Fill="#242027" />
            <Ellipse Margin="93">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding CurrentTrack.CoverCachePath}"
                                Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="24"
                     Height="24"
                     Fill="#E94B5F" />
            <Ellipse Width="7"
                     Height="7"
                     Fill="#100F13" />
        </Grid>
    </Grid>
</UserControl>
